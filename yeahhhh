-- 新增/替换的 Spoofing 功能 (Headless & Korblox)
-- ==========================================
local HeadlessConnection = nil
local KorbloxOriginalState = {}

local function ApplyHeadless(character)
    if HeadlessConnection then
        HeadlessConnection:Disconnect()
        HeadlessConnection = nil
    end
    local head = character:WaitForChild("Head", 5)
    if not head then return end
    
    local function hideHead()
        head.LocalTransparencyModifier = 1
        for _, child in ipairs(head:GetChildren()) do
            if child:IsA("Decal") then
                child.Transparency = 1
            end
        end
    end
    
    hideHead()
    HeadlessConnection = RunService.RenderStepped:Connect(function()
        if not character.Parent or not head.Parent then
            HeadlessConnection:Disconnect()
            HeadlessConnection = nil
            return
        end
        if Config['Spoofing']['Headless'] then
            hideHead()
        else
            -- 关闭时恢复
            head.LocalTransparencyModifier = 0
            for _, child in ipairs(head:GetChildren()) do
                if child:IsA("Decal") then
                    child.Transparency = 0
                end
            end
        end
    end)
end

local function ApplyKorblox(character)
    if not character then return end
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    if hum.RigType == Enum.HumanoidRigType.R15 then
        local rf = character:FindFirstChild("RightFoot")
        local rl = character:FindFirstChild("RightLowerLeg")
        local ru = character:FindFirstChild("RightUpperLeg")
        
        if ru and rl and rf then
            if Config['Spoofing']['Korblox'] then
                -- 保存原始状态 (仅保存一次)
                if not KorbloxOriginalState[character] then
                    KorbloxOriginalState[character] = {
                        ruMeshId = ru.MeshId,
                        ruTextureId = ru.TextureID,
                        ruColor = ru.Color,
                        ruTransparency = ru.Transparency,
                        rlTransparency = rl.Transparency,
                        rfTransparency = rf.Transparency
                    }
                end
                -- 应用 Korblox
                rf.Transparency = 1
                rl.Transparency = 1
                ru.MeshId = "http://www.roblox.com/asset/?id=902942096"
                ru.TextureID = "http://roblox.com/asset/?id=902843398"
                ru.Color = Color3.new(1, 1, 1)
                ru.Transparency = 0
            else
                -- 恢复原始状态
                local orig = KorbloxOriginalState[character]
                if orig then
                    ru.MeshId = orig.ruMeshId
                    ru.TextureID = orig.ruTextureId
                    ru.Color = orig.ruColor
                    ru.Transparency = orig.ruTransparency
                    rl.Transparency = orig.rlTransparency
                    rf.Transparency = orig.rfTransparency
                    KorbloxOriginalState[character] = nil
                end
            end
        end
    else
        -- R6 逻辑 (如果需要)
        local rightLeg = character:FindFirstChild("Right Leg")
        if rightLeg then
            if Config['Spoofing']['Korblox'] then
                -- 保存原始状态
                if not KorbloxOriginalState[character] then
                    local mesh = rightLeg:FindFirstChildOfClass("SpecialMesh")
                    KorbloxOriginalState[character] = {
                        color = rightLeg.Color,
                        transparency = rightLeg.Transparency,
                        meshType = mesh and mesh.MeshType,
                        meshId = mesh and mesh.MeshId,
                        textureId = mesh and mesh.TextureId,
                        scale = mesh and mesh.Scale
                    }
                end
                -- 应用
                rightLeg.Color = Color3.fromRGB(64, 64, 64)
                rightLeg.Transparency = 0
                local mesh = rightLeg:FindFirstChildOfClass("SpecialMesh")
                if not mesh then
                    mesh = Instance.new("SpecialMesh")
                    mesh.Parent = rightLeg
                end
                mesh.MeshType = Enum.MeshType.FileMesh
                mesh.MeshId = "rbxassetid://101851696"
                mesh.TextureId = "rbxassetid://101851254"
                mesh.Scale = Vector3.new(1, 1, 1)
            else
                -- 恢复
                local orig = KorbloxOriginalState[character]
                if orig then
                    rightLeg.Color = orig.color
                    rightLeg.Transparency = orig.transparency
                    local mesh = rightLeg:FindFirstChildOfClass("SpecialMesh")
                    if mesh then
                        mesh.MeshType = orig.meshType or Enum.MeshType.Brick
                        mesh.MeshId = orig.meshId or ""
                        mesh.TextureId = orig.textureId or ""
                        mesh.Scale = orig.scale or Vector3.new(1,1,1)
                    end
                    KorbloxOriginalState[character] = nil
                end
            end
        end
    end
end

local function HandleSpoofing(character)
    if not character then return end
    ApplyHeadless(character)
    ApplyKorblox(character)
end

